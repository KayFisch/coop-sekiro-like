[ext_resource type="Script" path="res://actors/bosses/sphaera_pendula/sphaera_pendula.gd" id="1_sphaera"]

[sub_resource type="Shader" id="Shader_disc"]
code = "shader_type canvas_item;

// Cuts the rect down to the disc inscribed in it; softness (in UV units) feathers the edge.
uniform float softness = 0.02;

void fragment() {
	float d = distance(UV, vec2(0.5));
	COLOR.a *= 1.0 - smoothstep(0.5 - softness, 0.5, d);
}
"

